<Window x:Class="OCRCaptureTool.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCRCaptureTool Full" Width="560" Height="230"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="True" Background="Transparent" AllowsTransparency="True"
        Topmost="True" Icon="assets/app_icon.ico">
    <Window.Resources>
        <Style x:Key="StartupProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#252C39"/>
            <Setter Property="Foreground" Value="#5B8CFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#252C39" CornerRadius="5"/>
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="#5B8CFF" CornerRadius="5"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Border CornerRadius="14" Background="#171B24" BorderBrush="#303644" BorderThickness="1" Padding="24,20">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.48" Color="#000000"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="OCR 速记器 · 轻量版" Foreground="#F4F7FF" FontFamily="Microsoft YaHei UI" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" x:Name="PercentText" Text="0%" Foreground="#7FA9FF" FontFamily="Microsoft YaHei UI" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="StageText" Text="正在启动…" Foreground="#E9EDF7" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold"/>
                <TextBlock Grid.Row="4" x:Name="DetailText" Text="检查程序资源与 PP-OCRv6 Medium 运行环境…" Foreground="#AAB4C8" FontFamily="Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap"/>
                <ProgressBar Grid.Row="6" x:Name="Progress" Minimum="0" Maximum="100" Value="0" Style="{StaticResource StartupProgressStyle}"/>
                <TextBlock Grid.Row="8" Text="首次初始化可能需要更久；后续模型与运行库会直接复用。" Foreground="#69758C" FontFamily="Microsoft YaHei UI" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
