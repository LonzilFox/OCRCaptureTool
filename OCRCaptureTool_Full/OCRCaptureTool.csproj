<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>OCRCaptureTool.Program</StartupObject>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OCRCaptureTool</AssemblyName>
    <RootNamespace>OCRCaptureTool</RootNamespace>
    <ApplicationIcon>assets\app_icon.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <AssemblyVersion>0.2.1.0</AssemblyVersion>
    <FileVersion>0.2.1.0</FileVersion>
    <Authors>LonzilTools</Authors>
    <Product>OCRCaptureTool Full</Product>
    <Description>PP-OCRv6 Medium desktop OCR capture tool using RapidOcrNet and ONNX Runtime.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\app_icon.png" />
    <Resource Include="assets\app_icon.ico" />
    <Content Include="Models\v6\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
