<Window x:Class="OCRCaptureTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 速记器 · 轻量版"
        Height="690" Width="1080" MinWidth="900" MinHeight="570"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="Transparent" AllowsTransparency="True"
        Foreground="{StaticResource Text}" Icon="assets/app_icon.ico"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Border x:Name="WindowSurface" Background="#171B24" BorderBrush="#303644" BorderThickness="1" CornerRadius="16" SnapsToDevicePixels="True">
            <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="10" Opacity="0.57" Color="#000000"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- FULL TITLE BAR: exact 54px height, 16/8/10/8 margins, 9px spacing. -->
                <Border Grid.Row="0" Background="#1B202B" BorderBrush="#2B3140" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,8,10,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Width="36" Height="36"><Image Source="assets/app_icon.png" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="OCR 速记器 · 轻量版" Foreground="#F5F7FC" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="区域识别 · 文本累计" Foreground="#7E899F" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PinButton" Content="置顶" Style="{StaticResource PinButtonStyle}" Margin="0,0,9,0" Click="Pin_Click"/>
                            <Button Content="—" Style="{StaticResource WindowButtonStyle}" Margin="0,0,9,0" Click="Min_Click"/>
                            <Button x:Name="MaxButton" Content="□" Style="{StaticResource WindowButtonStyle}" Margin="0,0,9,0" Click="Max_Click"/>
                            <Button Content="×" Style="{StaticResource CloseButtonStyle}" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- FULL BODY: 16/12/16/12 margins and 12px vertical spacing. -->
                <Grid Grid.Row="1" Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- FULL ACTION ROW: exact 8px spacing and 38px control height. -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Button x:Name="CaptureButton" Content="＋  截取识别    F8" Style="{StaticResource PrimaryButtonStyle}" Click="Capture_Click" Margin="0,0,8,0"/>
                        <Button Content="撤回" Style="{StaticResource SecondaryButtonStyle}" Click="Undo_Click" Margin="0,0,8,0"/>
                        <Button Content="删除选中" Style="{StaticResource SecondaryButtonStyle}" Click="Delete_Click" Margin="0,0,8,0"/>
                        <Button Content="恢复" Style="{StaticResource SecondaryButtonStyle}" Click="Restore_Click" Margin="0,0,8,0"/>
                        <Button Content="复制全部" Style="{StaticResource SecondaryButtonStyle}" Click="Copy_Click" Margin="0,0,8,0"/>
                        <Button Content="导出 TXT" Style="{StaticResource SecondaryButtonStyle}" Click="Export_Click" Margin="0,0,8,0"/>
                        <Button Content="清空" Style="{StaticResource SecondaryButtonStyle}" Click="Clear_Click"/>
                    </StackPanel>

                    <!-- FULL SETTINGS BOX: #1D222D / border #2C3341 / radius 11 / 12,8 padding. -->
                    <Border Grid.Row="2" Background="#1D222D" BorderBrush="#2C3341" BorderThickness="1" CornerRadius="11" Padding="12,8,12,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="识别模型" Foreground="#8893A8" FontSize="12" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#1B3027" BorderBrush="#2B5440" BorderThickness="1" CornerRadius="8" Padding="9,4">
                                <TextBlock Text="PP-OCRv6 Small · 快速中文" Foreground="#8ED9AE" FontSize="11"/>
                            </Border>
                            <CheckBox Grid.Column="4" x:Name="EnhanceCheck" Content="智能小字增强" IsChecked="True"/>
                            <CheckBox Grid.Column="6" x:Name="HeadersCheck" Content="显示批次标题" IsChecked="True" Checked="Headers_Changed" Unchecked="Headers_Changed"/>
                            <Border Grid.Column="8" Background="#1B3027" BorderBrush="#2B5440" BorderThickness="1" CornerRadius="8" Padding="9,4">
                                <TextBlock Text="本地识别 · 内容不上传" Foreground="#8ED9AE" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- FULL MAIN SPLITTER: initial 320:720 ratio, 8px handle. -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="720*"/></Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1B202A" BorderBrush="#2D3442" BorderThickness="1" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="识别批次" Foreground="#F2F4FA" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#252E43" BorderBrush="#36476D" BorderThickness="1" CornerRadius="8" Padding="8,3">
                                        <TextBlock x:Name="CountBadge" Text="0" Foreground="#AFC2FF" FontSize="11"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="双击编辑 · 长按拖动排序 · 支持多选删除" Foreground="#8893A8" FontSize="12"/>
                                <ListBox Grid.Row="4" x:Name="HistoryList"
                                         Style="{StaticResource FullHistoryListStyle}"
                                         ItemContainerStyle="{StaticResource FullHistoryItemStyle}"
                                         SelectionMode="Extended" AllowDrop="True"
                                         PreviewMouseLeftButtonDown="History_MouseDown" PreviewMouseMove="History_MouseMove"
                                         Drop="History_Drop" DragOver="History_DragOver" MouseDoubleClick="History_DoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="19" LineStackingStrategy="BlockLineHeight" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Style="{StaticResource SplitterStyle}" ShowsPreview="True"/>

                        <Border Grid.Column="2" Background="#1B202A" BorderBrush="#2D3442" BorderThickness="1" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="累计识别文字" Foreground="#F2F4FA" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Text="每次框选结果会持续追加，可直接复制或导出" Foreground="#8893A8" FontSize="12"/>
                                <Grid Grid.Row="4">
                                    <TextBox x:Name="CombinedText" Style="{StaticResource FullTextBoxStyle}" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Margin="11,10" Foreground="#69758C" FontSize="13" IsHitTestVisible="False" Text="按 F8 框选屏幕区域，识别结果会累计显示在这里。">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CombinedText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- FULL STATUS BOX: same radius/border/padding and 20x20 size grip. -->
                    <Border Grid.Row="6" Background="#1D222D" BorderBrush="#2C3341" BorderThickness="1" CornerRadius="11" Padding="12,7,8,7">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusDot" Text="●" Foreground="{StaticResource Green}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" x:Name="StatusText" Text="就绪。按 F8 或点击“截取识别”。" Foreground="#AEB7C8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="v0.2.0" Foreground="#647086" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <Grid Grid.Column="3" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Canvas Width="20" Height="20">
                                    <Line X1="13" Y1="18" X2="18" Y2="13" Stroke="#566176" StrokeThickness="1"/>
                                    <Line X1="9" Y1="18" X2="18" Y2="9" Stroke="#566176" StrokeThickness="1"/>
                                    <Line X1="5" Y1="18" X2="18" Y2="5" Stroke="#566176" StrokeThickness="1"/>
                                </Canvas>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
